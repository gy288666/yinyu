# 复制为同目录 .env（docker compose 会自动读取）：cp .env.example .env
# 也可以在启动 compose / 后端时以同名环境变量直接传入。.env 已被 .gitignore 忽略，请勿提交。

# ---------- MySQL ----------
# root 密码（必填）。注意：仅首次初始化空数据卷时生效；
# 已初始化的库需先 ALTER USER 修改密码，再同步更新此处。
MYSQL_ROOT_PASSWORD=

# ---------- JWT ----------
# HS256 签名密钥（必填，各至少 32 字节随机串）
# 生成：openssl rand -hex 32
JWT_USER_SECRET=
JWT_ADMIN_SECRET=

# ---------- MinIO（可选） ----------
# 使用 docker-compose-middleware.yml 或 deploy/minio 启动 MinIO 时必填 MINIO_ROOT_PASSWORD；
# 不启动 MinIO 时后端自动降级为本地目录存储，无需设置。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
