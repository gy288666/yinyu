# 用户门户镜像：Node 构建静态产物 -> Nginx 托管并反代 /api
# 构建上下文为仓库根目录：docker build -f deploy/docker/Dockerfile.web-portal .

FROM node:20-alpine AS build
WORKDIR /build
COPY web-portal/package*.json ./
RUN npm install --registry=https://registry.npmmirror.com
COPY web-portal/ .
RUN npm run build

FROM nginx:alpine
COPY --from=build /build/dist /usr/share/nginx/html
COPY deploy/docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
