# 后端镜像：两阶段构建（先用 Maven 编译，再用精简 JRE 运行）
# 构建上下文为仓库根目录：docker build -f deploy/docker/Dockerfile.backend .

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
# 先拷 pom 拉依赖，利用 Docker 层缓存，改代码不用重新下载依赖
COPY backend/pom.xml .
RUN mvn -q dependency:go-offline || true
COPY backend/src ./src
RUN mvn -q package -DskipTests

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /build/target/yinyu-backend.jar app.jar
# 上传文件的降级存储目录；仓库音乐素材由 compose 以只读卷挂到 /app/static-extra
RUN mkdir -p /app/storage /app/static-extra
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
